{
  "name": "claude-cli-portable-installer",
  "version": "0.3.4",
  "description": "Claude CLI 便携式安装器：一键完成 Git Bash、Claude CLI、.claude.json、系统 PATH 配置",
  "private": true,
  "main": "src/main/main.js",
  "author": "站着跑的火车 standtrain",
  "license": "MIT",
  "engines": {
    "node": "11.9.x",
    "npm": "6.x"
  },
  "scripts": {
